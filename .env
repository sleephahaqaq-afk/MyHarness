# ===== 模型入口（必填，缺失即报错，不做默认值回退）=====
# OpenAI 兼容协议：DeepSeek / 通义 / 本地 vLLM / Ollama(需 /v1) 均可
LLM_BASE_URL=https://stariver.top/v1
LLM_API_KEY=sk-4c68d873289a16784a6969f181bca12b48e12b9cf547d32f3b680c4fdc291231
LLM_MODEL=gpt-6-luna
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120

# ===== 联网搜索（web_search 专用，缺失则该工具直接禁用）=====
# 走 <LLM_BASE_URL>/responses 的服务端内置 web_search，复用 LLM_API_KEY；
# 这里单独一个模型名是为了能把搜索指到更便宜的模型，不与对话模型绑死。
WEB_SEARCH_MODEL=gpt-6-luna
WEB_SEARCH_MAX_TOKENS=2000
WEB_FETCH_MAX_CHARS=20000
# 端点不是 <LLM_BASE_URL>/responses 时用它覆盖
# WEB_SEARCH_URL=https://api.deepseek.com/responses

# ===== 基座路径（可选，缺省用仓库内默认位置）=====
# HARNESS_SKILLS_DIR=D:/Projects/py/MyHarness/skills
# HARNESS_SUBAGENT_DIR=D:/Projects/py/MyHarness/src/harness/subagents/configs
# HARNESS_MEMORY_DIR=D:/Projects/py/MyHarness/src/harness/memory
# HARNESS_YAML=D:/Projects/py/MyHarness/src/harness/harness_config.yaml

# ===== 运行上限 =====
HARNESS_MAX_MODEL_CALLS=40
HARNESS_MAX_TOOL_CALLS=80
HARNESS_TOOL_OUTPUT_CHARS=8000

# ===== 记忆分层与治理 =====
MEMORY_WARM_EPISODE_DAYS=7
MEMORY_RETRIEVAL_K=5
MEMORY_MIN_RETRIEVAL_SCORE=0.08
MEMORY_EPISODE_TTL_DAYS=90
MEMORY_MAX_EPISODES=200
MEMORY_MAX_SEMANTIC_HISTORY=3
MEMORY_HALF_LIFE_DAYS=30.0
MEMORY_WARM_BRIEF_CHARS=4000
MEMORY_WARM_ITEM_CHARS=160
MEMORY_MAX_WARM_EPISODES=5
MEMORY_IMMUTABLE_CONFIDENCE=1.0
MEMORY_LLM_EXTRACTION=false
MEMORY_TOOLS_ENABLED=true
